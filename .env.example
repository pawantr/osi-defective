# Copy to .env (gitignored) and fill in only the providers you use.
DEFECTIVE_PROVIDER=anthropic        # anthropic | openai | gemini | argo
DEFECTIVE_MODEL=balanced            # balanced | fast | (argo also: gpt-balanced, gpt-fast, gemini-balanced, gemini-fast)

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANL_USERNAME=                       # Argo: ANL network / VPN only

# Docling markdown of the paper corpus (kept on Box, not committed)
DEFECTIVE_CORPUS_DIR=~/Box-ptripathi/Hackathon_202610_ANL/docling_pdf/output
